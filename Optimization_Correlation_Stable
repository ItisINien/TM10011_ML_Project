# %% 1️⃣ LOAD DATA
import pandas as pd
import numpy as np
from collections import Counter
from sklearn.preprocessing import RobustScaler
from sklearn.model_selection import StratifiedKFold, train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.feature_selection import RFECV
from sklearn.metrics import roc_auc_score, accuracy_score
from worcliver.load_data import load_data

data = load_data()
X = data.select_dtypes(include=[np.number])
y = data['label'].map({'benign': 0, 'malignant': 1})

# %% 2️⃣ TRAIN/VALIDATION SPLIT
X_trainval, X_test, y_trainval, y_test = train_test_split(
    X, y, test_size=0.2, stratify=y, random_state=42
)

# %% 3️⃣ NESTED CV SETUP
outer_cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
inner_cv = StratifiedKFold(n_splits=3, shuffle=True, random_state=42)

feature_counter = Counter()
outer_fold_preds = []   # Bewaar voorspellingen per fold
outer_fold_y = []

# --- STEP 1: Eerste nested CV om feature stability te bepalen
for outer_train_idx, outer_val_idx in outer_cv.split(X_trainval, y_trainval):

    X_outer_train = X_trainval.iloc[outer_train_idx].copy()
    X_outer_val = X_trainval.iloc[outer_val_idx].copy()
    y_outer_train = y_trainval.iloc[outer_train_idx]
    y_outer_val = y_trainval.iloc[outer_val_idx]

    # --- CORRELATION FILTER ---
    corr_matrix = X_outer_train.corr().abs()
    upper = corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))
    to_drop = [col for col in upper.columns if any(upper[col] > 0.9)]
    X_outer_train.drop(columns=to_drop, inplace=True)
    X_outer_val.drop(columns=to_drop, inplace=True)
    print("Removed features:", len(to_drop))

    # --- SCALE DATA ---
    scaler = RobustScaler()
    X_outer_train_scaled = scaler.fit_transform(X_outer_train)
    X_outer_val_scaled = scaler.transform(X_outer_val)

    # --- INNER RFECV FEATURE SELECTION ---
    rf_model = RandomForestClassifier(n_estimators=100, random_state=42)
    rfecv = RFECV(
        estimator=rf_model,
        step=10,
        cv=inner_cv,
        scoring='roc_auc',
        min_features_to_select=5,
        n_jobs=-1
    )
    rfecv.fit(X_outer_train_scaled, y_outer_train)

    selected_features = X_outer_train.columns[rfecv.support_]
    feature_counter.update(selected_features)
    print("RFECV selected features this fold:", rfecv.n_features_)

# --- TOP 20 STABIELE FEATURES ---
top_features = [f for f, _ in feature_counter.most_common(20)]
print("\nTop 20 meest stabiele features over alle folds:")
print(top_features)

# %% 4️⃣ NESTED CV MET ALLEEN TOP 20 FEATURES
all_y_outer_top = []
all_y_outer_proba_top = []

for outer_train_idx, outer_val_idx in outer_cv.split(X_trainval, y_trainval):

    X_outer_train = X_trainval.iloc[outer_train_idx].copy()[top_features]
    X_outer_val = X_trainval.iloc[outer_val_idx].copy()[top_features]
    y_outer_train = y_trainval.iloc[outer_train_idx]
    y_outer_val = y_trainval.iloc[outer_val_idx]

    # --- SCALE ---
    scaler = RobustScaler()
    X_outer_train_scaled = scaler.fit_transform(X_outer_train)
    X_outer_val_scaled = scaler.transform(X_outer_val)

    # --- TRAIN MODEL OP OUTER TRAIN FOLD ---
    clf = RandomForestClassifier(n_estimators=100, random_state=42)
    clf.fit(X_outer_train_scaled, y_outer_train)

    # --- PREDICT PROBABILITIES ---
    y_outer_proba = clf.predict_proba(X_outer_val_scaled)[:,1]
    all_y_outer_top.extend(y_outer_val)
    all_y_outer_proba_top.extend(y_outer_proba)

    fold_auc = roc_auc_score(y_outer_val, y_outer_proba)
    print(f"Fold AUC (top 20 features): {fold_auc:.3f}")

# %% 5️⃣ EVALUATE NESTED CV MET TOP 20 FEATURES
roc_auc_top = roc_auc_score(all_y_outer_top, all_y_outer_proba_top)
accuracy_top = accuracy_score(all_y_outer_top, [1 if p >= 0.5 else 0 for p in all_y_outer_proba_top])
print(f"\nNested CV ROC-AUC (top 20 features): {roc_auc_top:.3f}")
print(f"Nested CV Accuracy (top 20 features): {accuracy_top:.3f}")

# %% 6️⃣ FINALE MODEL TRAINEN OP TRAIN+VALIDATION MET TOP FEATURES
X_trainval_top = X_trainval[top_features].copy()
scaler_final = RobustScaler()
X_trainval_scaled = scaler_final.fit_transform(X_trainval_top)

clf_final = RandomForestClassifier(n_estimators=100, random_state=42)
clf_final.fit(X_trainval_scaled, y_trainval)
print("\nFinal model trained on train+validation set with top 20 features.")