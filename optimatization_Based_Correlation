# %% IMPORTS
import pandas as pd
import numpy as np
from sklearn.preprocessing import RobustScaler
from sklearn.model_selection import StratifiedKFold, train_test_split, GridSearchCV
from sklearn.ensemble import RandomForestClassifier
from sklearn.feature_selection import RFECV
from sklearn.metrics import roc_auc_score, accuracy_score
import matplotlib.pyplot as plt
from worcliver.load_data import load_data

# %% 1️⃣ LOAD DATA
data = load_data()
X = data.select_dtypes(include=[np.number])
y = data['label'].map({'benign': 0, 'malignant': 1})

# %% 2️⃣ TRAIN/TEST SPLIT
X_trainval, X_test, y_trainval, y_test = train_test_split(
    X, y, test_size=0.2, stratify=y, random_state=42
)

# %% 3️⃣ NESTED CV SETUP
outer_cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
inner_cv = StratifiedKFold(n_splits=3, shuffle=True, random_state=42)

all_y_outer = []
all_y_outer_proba = []
feature_importances_list = []

# Grid voor RandomForest hyperparameters
param_grid = {
    'n_estimators': [100, 200],
    'max_depth': [None, 5, 10]
}

for outer_train_idx, outer_val_idx in outer_cv.split(X_trainval, y_trainval):
    X_outer_train, X_outer_val = X_trainval.iloc[outer_train_idx], X_trainval.iloc[outer_val_idx]
    y_outer_train, y_outer_val = y_trainval.iloc[outer_train_idx], y_trainval.iloc[outer_val_idx]   

    # -----------------------------
    # 1. CORRELATION FILTER
    # -----------------------------
    corr_matrix = X_outer_train.corr().abs()
    upper = corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))
    to_drop = [col for col in upper.columns if any(upper[col] > 0.9)]
    X_outer_train = X_outer_train.drop(columns=to_drop)
    X_outer_val = X_outer_val.drop(columns=to_drop)
    print("Removed features:", len(to_drop))

    # --- SCALE DATA ---
    scaler = RobustScaler()
    X_outer_train_scaled = scaler.fit_transform(X_outer_train)
    X_outer_val_scaled = scaler.transform(X_outer_val)

    # --- RFECV FEATURE SELECTION ---
    rf_model = RandomForestClassifier(random_state=42)
    rfecv = RFECV(
        estimator=rf_model,
        step=1,
        cv=inner_cv,
        scoring='roc_auc',
        min_features_to_select=5, 
        n_jobs=-1
    )
    rfecv.fit(X_outer_train_scaled, y_outer_train)
    print("Selected features:", rfecv.n_features_)

    # Selecteer features
    selected_features = X_outer_train.columns[rfecv.support_]
    X_outer_train_selected = pd.DataFrame(X_outer_train_scaled, columns=X_outer_train.columns)[selected_features]
    X_outer_val_selected = pd.DataFrame(X_outer_val_scaled, columns=X_outer_val.columns)[selected_features]

    # --- GRID SEARCH VOOR RANDOM FOREST HYPERPARAMETERS ---
    clf_base = RandomForestClassifier(random_state=42)
    grid_search = GridSearchCV(
        estimator=clf_base,
        param_grid=param_grid,
        cv=inner_cv,
        scoring='roc_auc',
        n_jobs=-1
    )
    grid_search.fit(X_outer_train_selected, y_outer_train)

    # Beste model toepassen op outer validation fold
    best_clf = grid_search.best_estimator_
    y_outer_proba = best_clf.predict_proba(X_outer_val_selected)[:,1]

    all_y_outer.extend(y_outer_val)
    all_y_outer_proba.extend(y_outer_proba)
    fold_auc = roc_auc_score(y_outer_val, y_outer_proba)
    print(f"Outer fold AUC: {fold_auc:.3f}")

    # --- OPSLAAN FEATURE IMPORTANCES ---
    importances = best_clf.feature_importances_
    feature_importances_list.append(pd.DataFrame({
        'feature': selected_features,
        'importance': importances
    }))

# %% 4️⃣ EVALUATE NESTED CV
roc_auc = roc_auc_score(all_y_outer, all_y_outer_proba)
accuracy = accuracy_score(all_y_outer, [1 if p >= 0.5 else 0 for p in all_y_outer_proba])
print(f"Nested CV ROC-AUC: {roc_auc:.3f}")
print(f"Nested CV Accuracy (threshold 0.5): {accuracy:.3f}")

# %% 5️⃣ FEATURE IMPORTANCE OVER ALLE FOLDS
feature_importance_df = pd.concat(feature_importances_list)
feature_importance_mean = feature_importance_df.groupby('feature')['importance'].mean().sort_values(ascending=False)

threshold = 0.01
interesting_features = feature_importance_mean[feature_importance_mean > threshold]
print(f"Aantal belangrijke features: {len(interesting_features)}")

# Plot top 30 features
plt.figure(figsize=(10,6))
plt.barh(feature_importance_mean.index[:30][::-1], feature_importance_mean.values[:30][::-1])
plt.xlabel('Mean Feature Importance over folds')
plt.title('Top 30 features RandomForest')
plt.show()