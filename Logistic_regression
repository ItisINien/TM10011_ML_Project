# %% 1️⃣ CUSTOM TRANSFORMER
class CorrUnivariateSelector(BaseEstimator, TransformerMixin):
    """
    1️⃣ Verwijdert constant features
    2️⃣ Verwijdert sterk correlerende features (Spearman)
    3️⃣ Selecteert top-k features via univariate ANOVA
    """
    def __init__(self, k=200, corr_threshold=0.9):
        self.k = k
        self.corr_threshold = corr_threshold

    def fit(self, X, y):
        X_df = X.copy()

        # 1️⃣ Verwijder constant features
        constant_mask = X_df.nunique(dropna=False) <= 1
        self.constant_features_ = X_df.columns[constant_mask].to_list()
        X_df = X_df.drop(columns=self.constant_features_, errors="ignore")

        # 2️⃣ Verwijder sterk correlerende features
        corr_matrix = X_df.corr(method='spearman').abs()
        upper = corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))
        self.corr_features_ = [col for col in upper.columns if any(upper[col] > self.corr_threshold)]
        X_df = X_df.drop(columns=self.corr_features_, errors="ignore")

        # 3️⃣ Top-k univariate features
        k_final = min(self.k, X_df.shape[1])
        self.selector_ = SelectKBest(score_func=f_classif, k=k_final)
        self.selector_.fit(X_df, y)
        self.features_ = X_df.columns[self.selector_.get_support()].to_list()

        return self

    def transform(self, X):
        X_df = X.copy()
        X_df = X_df.drop(columns=self.constant_features_, errors="ignore")
        X_df = X_df.drop(columns=self.corr_features_, errors="ignore")
        X_df = pd.DataFrame(self.selector_.transform(X_df), columns=self.features_)
        return X_df

